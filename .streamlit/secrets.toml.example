# 이 파일을 secrets.toml 로 복사한 뒤 비밀번호를 넣으세요.
# secrets.toml 은 깃/공유에 올리지 마세요.
APP_PASSWORD = "바꿀비밀번호"

# 다른 기기·리부트 후에도 즐겨찾기를 이어가려면 classic 토큰에 gist 권한만 주면 됩니다.
# GitHub → Settings → Developer settings → Personal access tokens (classic)
# Streamlit Cloud: Manage app → Settings → Secrets 에도 같은 값을 넣습니다.
GITHUB_TOKEN = "ghp_여기에붙여넣기"
