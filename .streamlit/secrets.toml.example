# 이 파일을 secrets.toml 로 복사한 뒤 비밀번호를 넣으세요.
# secrets.toml 은 깃/공유에 올리지 마세요.
APP_PASSWORD = "바꿀비밀번호"

# Streamlit Cloud 리부트 후에도 즐겨찾기·배점·시뮬레이션을 기기 상관없이 남기려면
# GitHub → Settings → Developer settings → Personal access tokens
# classic token 은 gist, fine-grained 는 Gists Read and write.
# Streamlit Cloud 의 App settings → Secrets 에도 같은 값을 넣습니다.
# GITHUB_TOKEN = "ghp_..."
# 이미 만든 gist 를 쓰려면 (없어도 앱이 trade-advisor-prefs.json gist 를 찾거나 만듭니다)
# PREFS_GIST_ID = ""
